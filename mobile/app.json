{
  "expo": {
    "name": "Urban Sentinel",
    "slug": "urban-sentinel",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/urban-sentinel-icon.png",
    "userInterfaceStyle": "light",
    "androidNavigationBar": {
      "backgroundColor": "#F4F7FB",
      "barStyle": "dark-content"
    },
    "splash": {
      "image": "./assets/urban-sentinel-icon.png",
      "imageWidth": 180,
      "resizeMode": "contain",
      "backgroundColor": "#F4F7FB"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.urbansentinel.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Urban Sentinel uses your location to alert you about nearby emergencies."
      }
    },
    "android": {
      "package": "com.urbansentinel.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/urban-sentinel-icon.png",
        "backgroundColor": "#F4F7FB"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "c97070c3-4a6d-4925-8f71-b6993bfa6489"
      }
    }
  }
}
