MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=urban_sentinel/sensors

DEVICE_ID=fire_node_1

# Set these to YOUR actual registered location (check GET /api/v1/auth/me
# on your mobile account) so test incidents reliably match your phone.
# IP-based auto-detection exists (--auto-locate flag) but proved
# unreliable in testing — it can be off by an entire city.
LATITUDE=12.9716
LONGITUDE=77.5946

PUBLISH_INTERVAL_SECONDS=5
